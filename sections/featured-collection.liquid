<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width">
    <div class="section-header{% if section.settings.center_text %} section-header--center{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="heading heading--medium">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte">{{ section.settings.text }}</div>
      {%- endif -%}
    </div>

    <div class="product-grid">
      {%- assign featured_collection = section.settings.collection -%}
      {%- for product in featured_collection.products limit: section.settings.products_to_show -%}
        <article class="product-card">
          <a href="{{ product.url }}" class="product-card__media">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 900 | image_tag: class: 'product-card__image', loading: 'lazy' }}
            {%- endif -%}
          </a>
          <div class="product-card__content">
            <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
            <p class="price">{{ product.price | money }}</p>
            {%- if section.settings.show_quick_add -%}
              {%- form 'product', product, class: 'product-form' -%}
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button class="button button--full" type="submit" {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}
                    {{ 'products.product.add_to_cart' | t }}
                  {%- else -%}
                    {{ 'products.product.sold_out' | t }}
                  {%- endif -%}
                </button>
              {%- endform -%}
            {%- endif -%}
          </div>
        </article>
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="product-card">
            <div class="product-card__media"></div>
            <div class="product-card__content">
              <h3>Produkt przykladowy {{ i }}</h3>
              <p class="price">199,00 zl</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="button-row" style="justify-content: center; margin-top: 2rem;">
        <a class="button button--secondary" href="{{ featured_collection.url | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "produkty"
    },
    {
      "type": "checkbox",
      "id": "center_text",
      "label": "Center text",
      "default": true
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show quick add",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sklep"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Najwazniejsze produkty gotowe do sprzedazy."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Podlacz kolekcje Shopify, aby automatycznie wyswietlac produkty w layoutcie landing page.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Zobacz wszystkie produkty"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
