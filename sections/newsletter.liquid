<section class="newsletter section-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.section_padding }}px 0;">
  <div class="container newsletter__inner newsletter__inner--{{ section.settings.layout }}">
    <div class="newsletter__text" style="color: {{ section.settings.text_color }};">
      {%- if section.settings.heading != blank -%}
        <h2 class="newsletter__heading h2" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtext != blank -%}
        <p class="newsletter__subtext">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}
    </div>

    {%- form 'customer', id: 'ContactFooter', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success" role="alert">{{ 'newsletter.success' | t }}</p>
      {%- endif -%}
      <div class="newsletter__input-group">
        <label for="NewsletterForm--{{ section.id }}" class="visually-hidden">{{ 'newsletter.label' | t }}</label>
        <input
          id="NewsletterForm--{{ section.id }}"
          type="email"
          name="contact[email]"
          class="newsletter__input"
          value="{{ form.email }}"
          placeholder="{{ section.settings.placeholder | escape }}"
          required
          autocomplete="email"
        >
        <button type="submit" class="btn btn--primary newsletter__btn" style="background-color: {{ section.settings.btn_bg }}; color: {{ section.settings.btn_text }};">
          {{ section.settings.btn_label | escape }}
        </button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Subscribe to our newsletter"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Be the first to know about new arrivals and exclusive offers."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Input placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "stacked", "label": "Stacked (centered)" },
        { "value": "inline", "label": "Inline (side by side)" }
      ],
      "default": "stacked"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Button background",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "btn_text",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
