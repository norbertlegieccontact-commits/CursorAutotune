        { "type": "preset", "settings": { "category": "Genres", "name": "Pop Vocal", "speed": 18, "humanize": 10, "mix": 100 } },
        { "type": "preset", "settings": { "category": "Genres", "name": "R&B Smooth", "speed": 35, "humanize": 35, "mix": 85 } },
        { "type": "preset", "settings": { "category": "Genres", "name": "Trap Vocal", "speed": 2, "humanize": 0, "mix": 100 } },
        { "type": "preset", "settings": { "category": "Genres", "name": "Hip Hop Clean", "speed": 24, "humanize": 12, "mix": 90 } },
        { "type": "preset", "settings": { "category": "Creative", "name": "Robot", "speed": 0, "humanize": 0, "mix": 100 } },
        { "type": "preset", "settings": { "category": "Creative", "name": "Deep Voice", "speed": 12, "humanize": 5, "mix": 100 } },
        { "type": "preset", "settings": { "category": "Creative", "name": "Chipmunk", "speed": 8, "humanize": 0, "mix": 100 } },
        { "type": "preset", "settings": { "category": "Creative", "name": "Lo-Fi", "speed": 70, "humanize": 50, "mix": 55 } },
        { "type": "preset", "settings": { "category": "Live", "name": "Live Mode", "speed": 0, "humanize": 0, "mix": 100 } },
        { "type": "preset", "settings": { "category": "Live", "name": "Studio Vocal", "speed": 22, "humanize": 18, "mix": 95 } }
      ]
    }
  ]
}
