    { "type": "text", "id": "humanize_label", "label": "Knob 2 label", "default": "Humanize" },
    { "type": "range", "id": "humanize_default", "label": "Knob 2 default", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 0 },
    { "type": "text", "id": "mix_label", "label": "Knob 3 label", "default": "Mix" },
    { "type": "range", "id": "mix_default", "label": "Knob 3 default", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "accent_cyan", "label": "Accent cyan", "default": "#00e5ff" },
    { "type": "color", "id": "accent_magenta", "label": "Accent magenta", "default": "#ff2d92" },
