    { "type": "color", "id": "text_dim", "label": "Text dim", "default": "#555555" },
    { "type": "color", "id": "bg_color", "label": "Page background", "default": "#000000" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "plugin_width", "label": "Plugin width", "min": 320, "max": 900, "step": 10, "unit": "px", "default": 700 },
    { "type": "checkbox", "id": "show_keyboard_hint", "label": "Show keyboard hint", "default": true }
  ],
  "blocks": [
    {
      "type": "preset",
      "name": "Preset",
      "settings": [
        { "type": "text", "id": "category", "label": "Category", "default": "Essential" },
        { "type": "text", "id": "name", "label": "Preset name", "default": "Natural" },
        { "type": "range", "id": "speed", "label": "Speed %", "min": 0, "max": 100, "step": 1, "default": 20 },
        { "type": "range", "id": "humanize", "label": "Humanize %", "min": 0, "max": 100, "step": 1, "default": 0 },
        { "type": "range", "id": "mix", "label": "Mix %", "min": 0, "max": 100, "step": 1, "default": 100 }
      ]
    }
  ],
  "presets": [
    {
      "name": "VoxTune Plugin",
      "blocks": [
        { "type": "preset", "settings": { "category": "Essential", "name": "Natural", "speed": 20, "humanize": 0, "mix": 100 } },
