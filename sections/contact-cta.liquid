<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width">
    <div class="contact-panel">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="heading heading--medium">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="rte" style="margin-top: 1rem;">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- form 'contact', class: 'contact-form' -%}
        {%- if form.posted_successfully? -%}
          <p class="rte">{{ 'contact.success' | t }}</p>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <input type="text" name="contact[name]" placeholder="{{ 'contact.name' | t }}" autocomplete="name">
        <input type="email" name="contact[email]" placeholder="{{ 'contact.email' | t }}" autocomplete="email" required>
        <textarea name="contact[body]" rows="5" placeholder="{{ 'contact.message' | t }}"></textarea>
        <button class="button" type="submit">{{ section.settings.button_label | escape }}</button>
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact CTA",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "kontakt"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Kontakt"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Chcesz dopasowac motyw do gotowego projektu 1:1?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Wgraj docelowe grafiki i teksty, a sekcje pozwola zlozyc strone w Shopify bez przebudowy fundamentow.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Wyslij wiadomosc"
    }
  ],
  "presets": [
    {
      "name": "Contact CTA"
    }
  ]
}
{% endschema %}
