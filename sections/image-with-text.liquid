<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width image-text{% if section.settings.reverse_layout %} image-text--reverse{% endif %}">
    <div class="image-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'image-text__image', loading: 'lazy', sizes: '(min-width: 900px) 50vw, 100vw' }}
      {%- endif -%}
    </div>

    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="heading heading--medium">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="rte" style="margin-top: 1rem;">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="button-row" style="margin-top: 1.5rem;">
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "historia"
    },
    {
      "type": "checkbox",
      "id": "reverse_layout",
      "label": "Image on right",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Sekcja opisowa"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opowiedz klientowi, co sprawia, ze oferta jest wyjatkowa."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Ten blok sprawdza sie jako opis uslugi, historia marki, sekcja procesu lub rozbudowany argument sprzedazowy.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Sprawdz oferte"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with text"
    }
  ]
}
{% endschema %}
