{%- liquid
  assign section_label = section.settings.heading | default: shop.name | strip_html
  assign has_features = false

  for block in section.blocks
    if block.type == 'feature'
      assign has_features = true
      break
    endif
  endfor
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --page-background: {{ section.settings.background_color }};
    --page-text: {{ section.settings.text_color }};
    --page-muted: {{ section.settings.muted_text_color }};
    --page-accent: {{ section.settings.accent_color }};
    --page-card: {{ section.settings.card_background }};
    --page-border: {{ section.settings.border_color }};
    --page-radius: {{ section.settings.border_radius }}px;
    --page-max-width: {{ section.settings.page_width }}px;
    --page-padding-top: {{ section.settings.padding_top }}px;
    --page-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section class="one-to-one-page" aria-label="{{ section_label | escape }}">
  <div class="one-to-one-page__inner">
    <div class="one-to-one-page__hero one-to-one-page__hero--{{ section.settings.media_position }}">
      <div class="one-to-one-page__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="one-to-one-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h1 class="one-to-one-page__heading">{{ section.settings.heading }}</h1>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="one-to-one-page__subheading rte">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="one-to-one-page__actions">
            {%- if section.settings.primary_label != blank -%}
              <a class="button button--primary" href="{{ section.settings.primary_link | default: '#' }}">
                {{ section.settings.primary_label | escape }}
              </a>
            {%- endif -%}

            {%- if section.settings.secondary_label != blank -%}
              <a class="button button--secondary" href="{{ section.settings.secondary_link | default: '#' }}">
                {{ section.settings.secondary_label | escape }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="one-to-one-page__media">
        {%- if section.settings.hero_image != blank -%}
          {{
            section.settings.hero_image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              widths: '480, 720, 960, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              class: 'one-to-one-page__image'
          }}
        {%- else -%}
          <div class="one-to-one-page__placeholder">
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- if has_features -%}
      <div class="one-to-one-page__feature-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'feature' -%}
            <article class="one-to-one-page__feature-card" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}
                <span class="one-to-one-page__feature-icon">{{ block.settings.icon | escape }}</span>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h2>{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
            </article>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'rich_text' -%}
          <div class="one-to-one-page__rich-text" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>

        {%- when 'image_text' -%}
          <div class="one-to-one-page__image-text one-to-one-page__image-text--{{ block.settings.image_position }}" {{ block.shopify_attributes }}>
            <div class="one-to-one-page__image-text-media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '360, 540, 720, 960, 1200',
                    sizes: '(min-width: 990px) 45vw, 100vw',
                    class: 'one-to-one-page__image'
                }}
              {%- else -%}
                <div class="one-to-one-page__placeholder">
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            <div class="one-to-one-page__image-text-copy">
              {%- if block.settings.heading != blank -%}
                <h2>{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <div class="rte">{{ block.settings.text }}</div>
              {%- endif -%}
              {%- if block.settings.link_label != blank -%}
                <a class="text-link" href="{{ block.settings.link | default: '#' }}">
                  {{ block.settings.link_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>

        {%- when 'call_to_action' -%}
          <div class="one-to-one-page__cta" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h2>{{ block.settings.heading | escape }}</h2>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <a class="button button--primary" href="{{ block.settings.button_link | default: '#' }}">
                {{ block.settings.button_label | escape }}
              </a>
            {%- endif -%}
          </div>

        {%- when 'custom_liquid' -%}
          <div class="one-to-one-page__custom-liquid" {{ block.shopify_attributes }}>
            {{ block.settings.custom_liquid }}
          </div>
      {%- endcase -%}
    {%- endfor -%}

    {%- if section.settings.custom_liquid != blank -%}
      <div class="one-to-one-page__custom-liquid one-to-one-page__custom-liquid--section">
        {{ section.settings.custom_liquid }}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.custom_css != blank -%}
  <style>
    {{ section.settings.custom_css }}
  </style>
{%- endif -%}

{% schema %}
{
  "name": "1:1 landing page",
  "tag": "section",
  "class": "section-one-to-one-page",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New collection"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Your exact landing page, ready for Shopify"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Replace this starter content with the copy, imagery, spacing, and styling from the Claude Code project.</p>"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Hero image position",
      "default": "right",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Layout and colors"
    },
    {
      "type": "range",
      "id": "page_width",
      "label": "Page width",
      "min": 960,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 180,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Card and media radius",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#f7f1e8"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#151515"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text",
      "default": "#5f5a52"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#dfd6ca"
    },
    {
      "type": "header",
      "content": "Advanced 1:1 migration"
    },
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "Custom Liquid or HTML after section content",
      "info": "Use this for markup that must match the original Claude Code page exactly."
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Paste CSS from the original page here or move it into assets/theme.css after migration."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature card",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon or short label"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Editable content"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Adjust this card from the Shopify Theme Editor.</p>"
        }
      ]
    },
    {
      "type": "rich_text",
      "name": "Rich text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Section heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add copy from the original design here.</p>"
        }
      ]
    },
    {
      "type": "image_text",
      "name": "Image with text",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "select",
          "id": "image_position",
          "label": "Image position",
          "default": "left",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Image with text"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Use this block for split sections from the original page.</p>"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    },
    {
      "type": "call_to_action",
      "name": "Call to action",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Ready to shop?"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Add a concise closing message.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid or HTML",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid or HTML"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "1:1 landing page",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
