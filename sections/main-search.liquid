<section class="main-search section-{{ section.id }}">
  <div class="container">
    <h1 class="main-search__title h2">{{ 'search.title' | t }}</h1>

    <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
      <div class="search-form__input-group">
        <input
          type="search"
          name="q"
          value="{{ search.terms | escape }}"
          placeholder="{{ 'search.placeholder' | t }}"
          class="search-form__input"
          autocomplete="off"
        >
        <button type="submit" class="btn btn--primary search-form__btn" aria-label="Search">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="8.5" cy="8.5" r="5.5" stroke="currentColor" stroke-width="1.5"/><path d="M18 18l-4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
      </div>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="search-results__count">{{ 'search.results_with_count' | t: count: search.results_count }}</p>
        <div class="product-grid product-grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="search-results__empty">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
