<section class="testimonials section-{{ section.id }}" style="background-color: {{ section.settings.bg_color }}; padding: {{ section.settings.section_padding }}px 0;">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-header section-header--{{ section.settings.heading_align }}">
        <h2 class="section-header__title h2" style="color: {{ section.settings.heading_color }};">{{ section.settings.heading | escape }}</h2>
      </div>
    {%- endif -%}

    <div class="testimonials__grid testimonials__grid--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        <div class="testimonials__item" {{ block.shopify_attributes }} style="background-color: {{ section.settings.card_bg }}; border-radius: {{ section.settings.card_radius }}px;">
          {%- if block.settings.rating > 0 -%}
            <div class="testimonials__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..5) -%}
                <span class="star {% if i <= block.settings.rating %}star--filled{% endif %}" style="color: {{ section.settings.star_color }};">★</span>
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <blockquote class="testimonials__quote" style="color: {{ section.settings.text_color }};">{{ block.settings.text | escape }}</blockquote>
          {%- endif -%}
          <footer class="testimonials__author">
            {%- if block.settings.author_photo != blank -%}
              <img src="{{ block.settings.author_photo | image_url: width: 60, height: 60, crop: 'center' }}" alt="{{ block.settings.author | escape }}" width="60" height="60" class="testimonials__author-photo" loading="lazy">
            {%- endif -%}
            <div>
              {%- if block.settings.author != blank -%}
                <cite class="testimonials__author-name" style="color: {{ section.settings.heading_color }};">{{ block.settings.author | escape }}</cite>
              {%- endif -%}
              {%- if block.settings.author_role != blank -%}
                <span class="testimonials__author-role" style="color: {{ section.settings.text_color }};">{{ block.settings.author_role | escape }}</span>
              {%- endif -%}
            </div>
          </footer>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Star rating",
          "min": 0,
          "max": 5,
          "step": 1,
          "default": 5,
          "info": "Set to 0 to hide stars"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Quote text",
          "default": "This is an amazing product!"
        },
        {
          "type": "image_picker",
          "id": "author_photo",
          "label": "Author photo (optional)"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author name",
          "default": "Happy Customer"
        },
        {
          "type": "text",
          "id": "author_role",
          "label": "Author role / location"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What our customers say"
    },
    {
      "type": "select",
      "id": "heading_align",
      "label": "Heading alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (desktop)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Star color",
      "default": "#f59e0b"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Author name color",
      "default": "#1a1a1a"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Quote text color",
      "default": "#4a4a4a"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background",
      "default": "#f9f9f9"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 10,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
