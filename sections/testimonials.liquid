<section class="section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width">
    <div class="section-header section-header--center">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="heading heading--medium">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="testimonial-grid">
      {%- for block in section.blocks -%}
        <article class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="rte">{{ block.settings.quote }}</div>
          <div class="testimonial-card__author">
            <div class="testimonial-card__avatar"></div>
            <div>
              <strong>{{ block.settings.author | escape }}</strong><br>
              <span class="rte">{{ block.settings.caption | escape }}</span>
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "opinie"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Opinie"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Zaufanie klientow zbudowane na konkretnych efektach."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "richtext",
          "id": "quote",
          "label": "Quote",
          "default": "<p>Strona wyglada nowoczesnie, jest szybka i od razu prowadzi klienta do zakupu.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Klient"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption",
          "default": "Zweryfikowana opinia"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}
