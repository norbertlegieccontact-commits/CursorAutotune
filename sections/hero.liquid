<section class="hero section" id="{{ section.settings.anchor | default: section.id }}">
  <div class="page-width hero__grid">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="rte hero__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <div class="button-row">
        {%- if section.settings.primary_label != blank -%}
          <a class="button" href="{{ section.settings.primary_link | default: routes.all_products_collection_url }}">
            {{ section.settings.primary_label | escape }}
          </a>
        {%- endif -%}

        {%- if section.settings.secondary_label != blank -%}
          <a class="button button--secondary" href="{{ section.settings.secondary_link | default: '#oferta' }}">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="stat-strip">
          {%- for block in section.blocks -%}
            <div class="stat-card" {{ block.shopify_attributes }}>
              <strong>{{ block.settings.value | escape }}</strong>
              <span>{{ block.settings.label | escape }}</span>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="hero__media">
      <div class="hero__media-shell">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'hero__image', loading: 'eager', sizes: '(min-width: 900px) 50vw, 100vw' }}
        {%- else -%}
          <div class="hero__media-placeholder">
            <span>Dodaj glowne zdjecie lub render z projektu</span>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor ID",
      "default": "start"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Auto detailing / tuning / shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Zbuduj wyglad auta dokladnie tak, jak go zaplanowales."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Edytowalny hero pod Shopify przygotowany tak, aby mozna bylo podmienic tresci, zdjecia i CTA na dokladny projekt strony.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Zobacz produkty"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Jak to dziala"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "1:1"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Odwzorowanie layoutu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "1:1",
            "label": "Wyglad projektu"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "OS 2.0",
            "label": "Edytowalne sekcje"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "100%",
            "label": "Responsive"
          }
        }
      ]
    }
  ]
}
{% endschema %}
