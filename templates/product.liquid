<div class="page-width">
  <h1>{{ product.title }}</h1>
  <div class="rte">
    <p>{{ product.price | money }}</p>
    {{ product.description }}
    {% form 'product', product %}
      <select name="id">
        {% for variant in product.variants %}
          <option value="{{ variant.id }}">{{ variant.title }} - {{ variant.price | money }}</option>
        {% endfor %}
      </select>
      <button type="submit" name="add">{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}</button>
    {% endform %}
  </div>
</div>
