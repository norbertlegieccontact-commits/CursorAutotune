<div class="page-width">
  <h1>{{ 'customer.account.title' | t | default: 'My account' }}</h1>
  <div class="rte">
    <p>{{ 'customer.account.welcome' | t | default: 'Welcome' }}, {{ customer.name }}</p>
    <p><a href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t | default: 'View addresses' }}</a></p>
    <p><a href="{{ routes.account_logout_url }}">{{ 'customer.account.log_out' | t | default: 'Log out' }}</a></p>
    <h2>{{ 'customer.orders.title' | t | default: 'Orders' }}</h2>
    <ul>
      {% for order in customer.orders %}
        <li><a href="{{ order.customer_url }}">{{ order.name }}</a> — {{ order.created_at | date: '%B %d, %Y' }} — {{ order.total_price | money }}</li>
      {% else %}
        <li>{{ 'customer.orders.none' | t | default: 'No orders yet' }}</li>
      {% endfor %}
    </ul>
  </div>
</div>
