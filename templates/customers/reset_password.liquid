<div class="page-width">
  <h1>{{ 'customer.reset_password.title' | t | default: 'Reset password' }}</h1>
  <div class="rte">
    {% form 'reset_customer_password' %}
      {{ form.errors | default_errors }}
      <label>{{ 'customer.reset_password.password' | t | default: 'Password' }}<input type="password" name="customer[password]"></label>
      <label>{{ 'customer.reset_password.password_confirmation' | t | default: 'Confirm password' }}<input type="password" name="customer[password_confirmation]"></label>
      <button type="submit">{{ 'customer.reset_password.submit' | t | default: 'Reset' }}</button>
    {% endform %}
  </div>
</div>
