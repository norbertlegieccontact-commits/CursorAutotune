[
  {
    "name": "theme_info",
    "theme_name": "Custom Theme",
    "theme_version": "1.0.0",
    "theme_author": "Custom",
    "theme_documentation_url": "",
    "theme_support_url": ""
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary color",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_secondary",
        "label": "Secondary color",
        "default": "#4a4a4a"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent / Button color",
        "default": "#0066cc"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Page background",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text color",
        "default": "#1a1a1a"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Border color",
        "default": "#e5e7eb"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Headings font",
        "default": "helvetica_neue_n7"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "helvetica_neue_n4"
      },
      {
        "type": "range",
        "id": "font_size_base",
        "label": "Base font size",
        "min": 12,
        "max": 20,
        "step": 1,
        "unit": "px",
        "default": 16
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "container_width",
        "label": "Max container width",
        "min": 960,
        "max": 1600,
        "step": 40,
        "unit": "px",
        "default": 1280
      },
      {
        "type": "range",
        "id": "border_radius",
        "label": "Button / card border radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "default": 4
      }
    ]
  },
  {
    "name": "Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "32 x 32px .png recommended"
      }
    ]
  },
  {
    "name": "Animations",
    "settings": [
      {
        "type": "checkbox",
        "id": "animations_enabled",
        "label": "Enable animations",
        "default": true
      }
    ]
  },
  {
    "name": "Custom fonts (Google Fonts)",
    "settings": [
      {
        "type": "checkbox",
        "id": "custom_fonts",
        "label": "Load Google Fonts",
        "default": false
      },
      {
        "type": "text",
        "id": "google_fonts_url",
        "label": "Google Fonts URL",
        "info": "Paste the URL from fonts.google.com (href value)"
      }
    ]
  },
  {
    "name": "Custom code",
    "settings": [
      {
        "type": "textarea",
        "id": "custom_css",
        "label": "Custom CSS"
      },
      {
        "type": "textarea",
        "id": "custom_js",
        "label": "Custom JavaScript"
      }
    ]
  }
]
